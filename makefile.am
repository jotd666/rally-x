PROGNAME = rallyx
MAIN = ..\$(PROGNAME)
MAIN_AGA = $(MAIN)_aga
MAIN_ECS = $(MAIN)_ecs
MAIN_AGA_OBJ = amiga_aga.o
MAIN_ECS_OBJ = amiga_ecs.o

ifdef RELEASE_BUILD
OPT_RELEASE = --defsym RELEASE=1
OPT_RELEASE_LINK = -s
else
OPT_RELEASE = 
OPT_RELEASE_LINK = 
endif

# Bebbo's package usually installs itself there
GCC_BIN = C:\amiga-gcc\bin
ASM_BASE = $(GCC_BIN)/m68k-amigaos-as -c --defsym __amiga__=1
ASM = $(ASM_BASE) -m68000 $(OPT_RELEASE) 
ASM_020 = $(ASM_BASE) -m68020 --defsym MC68020=1 --defsym AGA_VERSION=1
MAIN_OBJ = amiga.o
WHDLOADER_AGA = ..\$(PROGNAME)_aga.slave
WHDLOADER_CHIP = ..\$(PROGNAME)_chip.slave
WHDLOADER = ..\$(PROGNAME).slave
WHDLOADER_AGA_CHIP = ..\$(PROGNAME)_aga_chip.slave
ASSETS = ..\assets\amiga
AMIGASRC = amiga




# those 2 are defined for my PC, should include whdload.i
# and system includes.
HDBASE = K:\jff\AmigaHD
WHDBASE = $(HDBASE)\PROJETS\HDInstall\DONE\WHDLoad
WHDASM = vasmm68k_mot -DDATETIME -I$(HDBASE)/amiga39_JFF_OS/include -I$(WHDBASE)\Include -I$(WHDBASE) -devpac -nosym -Fhunkexe


# leave MAIN_OBJ first
SHARED_OBJS = sounds.o ram.o rom.o vbr.o ReadJoyPad.o ptplayer.o 
AGA_OBJS = $(MAIN_AGA_OBJ) $(PROGNAME)_020.o graphics_aga.o 
ECS_OBJS = $(MAIN_ECS_OBJ) $(PROGNAME)_000.o graphics_ecs.o 

all: $(AMIGASRC)/graphics_aga.68k $(AMIGASRC)/graphics_ecs.68k $(AMIGASRC)/sounds.68k $(MAIN_AGA) $(MAIN_ECS) $(WHDLOADER_AGA) $(WHDLOADER_AGA_CHIP) $(WHDLOADER) $(WHDLOADER_CHIP)


clean:
	del $(AGA_OBJS) $(ECS_OBJS) $(SHARED_OBJS) $(MAIN_AGA) $(MAIN_ECS)
	
$(AMIGASRC)/graphics_aga.68k $(AMIGASRC)/graphics_ecs.68k: $(ASSETS)/convert_graphics.py
	cmd /c $(ASSETS)\convert_graphics.py

$(AMIGASRC)/sounds.68k: $(ASSETS)/convert_sounds.py $(ASSETS)/../sounds/rallyx_conv.mod
	cmd /c $(ASSETS)\convert_sounds.py
	del $(OBJS)\sound_entries.o $(OBJS)\sounds.o
	
$(MAIN_AGA): $(AGA_OBJS) $(SHARED_OBJS)
	$(GCC_BIN)/m68k-amigaos-ld $(OPT_RELEASE_LINK) -o $(MAIN_AGA) $(AGA_OBJS) $(SHARED_OBJS)
$(MAIN_ECS): $(ECS_OBJS) $(SHARED_OBJS)
	$(GCC_BIN)/m68k-amigaos-ld $(OPT_RELEASE_LINK) -o $(MAIN_ECS) $(ECS_OBJS) $(SHARED_OBJS)

ram.o: ram.68k
	$(ASM) ram.68k -o ram.o
rom.o: rom.68k
	$(ASM) rom.68k -o rom.o
$(PROGNAME)_000.o: $(PROGNAME).68k $(PROGNAME).inc data.inc sounds.inc
	$(ASM) $(PROGNAME).68k -o $(PROGNAME)_000.o
$(PROGNAME)_020.o: $(PROGNAME).68k $(PROGNAME).inc data.inc sounds.inc
	$(ASM) $(PROGNAME).68k -o $(PROGNAME)_020.o
amiga_aga.o: $(AMIGASRC)/amiga.68k options.inc $(PROGNAME).inc $(AMIGASRC)/scroll_table_16.68k $(AMIGASRC)/ReadJoyPad.i $(AMIGASRC)/palette_aga.68k
	$(ASM_020) -Iamiga $(AMIGASRC)/amiga.68k -o amiga_aga.o
amiga_ecs.o: $(AMIGASRC)/amiga.68k options.inc $(PROGNAME).inc $(AMIGASRC)/scroll_table_16.68k $(AMIGASRC)/ReadJoyPad.i $(AMIGASRC)/palette_ecs.68k
	$(ASM) -Iamiga $(AMIGASRC)/amiga.68k -o amiga_ecs.o
vbr.o: $(AMIGASRC)/vbr.68k
	$(ASM_020) -Iamiga $(AMIGASRC)/vbr.68k -o vbr.o
ptplayer.o: $(AMIGASRC)/ptplayer.68k
	$(ASM) -I$(AMIGASRC) $(AMIGASRC)/ptplayer.68k -o ptplayer.o
sounds.o: $(AMIGASRC)/sounds.68k
	$(ASM) -I$(AMIGASRC) $(AMIGASRC)/sounds.68k -o sounds.o
ReadJoyPad.o: $(AMIGASRC)/ReadJoyPad.68k amiga/ReadJoyPad.i
	$(ASM) -I$(AMIGASRC) $(AMIGASRC)/ReadJoyPad.68k -o ReadJoyPad.o
graphics_aga.o: $(AMIGASRC)/graphics_aga.68k $(PROGNAME).inc
	$(ASM) $(AMIGASRC)/graphics_aga.68k -o graphics_aga.o
graphics_ecs.o: $(AMIGASRC)/graphics_ecs.68k $(PROGNAME).inc
	$(ASM) $(AMIGASRC)/graphics_ecs.68k -o graphics_ecs.o


$(WHDLOADER_AGA) : $(AMIGASRC)/$(PROGNAME)AGAHD.s
	wdate.py> datetime
	$(WHDASM) -o $(WHDLOADER_AGA) $(AMIGASRC)/$(PROGNAME)AGAHD.s
	
$(WHDLOADER_CHIP) : $(AMIGASRC)/$(PROGNAME)HD.s
	wdate.py> datetime
	$(WHDASM) -DCHIP_ONLY -o $(WHDLOADER_CHIP) $(AMIGASRC)/$(PROGNAME)HD.s
	
$(WHDLOADER) : $(AMIGASRC)/$(PROGNAME)HD.s
	wdate.py> datetime
	$(WHDASM) -o $(WHDLOADER) $(AMIGASRC)/$(PROGNAME)HD.s
	
$(WHDLOADER_AGA_CHIP) : $(AMIGASRC)/$(PROGNAME)AGAHD.s
	wdate.py> datetime
	$(WHDASM) -DCHIP_ONLY -o $(WHDLOADER_AGA_CHIP) $(AMIGASRC)/$(PROGNAME)AGAHD.s
