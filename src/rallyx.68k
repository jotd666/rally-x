* screen layout (intermixed with game variables!!):
*
* status right screen: 8 bytes every 32 bytes
* 0x8044-47: start of status right screen (4 first chars)
* 0x8040-43: end of status right screen (4 last chars)
* next row: +0x20
* +0x800: attributes
*
* main screen:
* 0x8400: top left (at start 0x8440)
* +0x20: next row
* +0x800: attributes
* wraps with scrolling

* during game: 0 vertical (up or down), $FF horizontal
* control_flags_8020: 0: intro, 1: press start, 2: running, 3: dead/waiting
* music control: set a bit (or several!) to start a tune. Bit 0 clears
* when playing and resets to 1 once music has completed
* bit 7: game start music
* bit 6: unused music?
* bit 5: end level music
* bit 4: in-game music
* bit 3: stop music
* bit 2: high score music
* bit 0 on: idle, off: tune playing
* sound control:
* bit 7: stop engine loop
* bit 6: engine loop
* bit 5: low fuel warning alarm
* bit 4: changes engine sound when dropping smoke cloud
* bit 3: special flag picked up
* bit 2: flag picked up
* bit 1: fuel countdown
* bit 0: extra life

l_0000:
	jra	boot_3800                          	| [$0000: jp   boot_3800]

start_0003:                             	| [global]
* reaches here when all memory & screen tests are done
* starting from here doesn't work, though
* (stack is probably not positioned properly)
l_0003:
	 |  [$0003: ld   sp,$8400]
	move.b	infinite_fuel_flag,saved_infinite_fuel_flag

	jra	l_003a                             	| [$0006: jr   $003a]

irq_0030:
	jra	irq_01f0                           	| [$0030: jp   irq_01f0] [freq=low, count=6%]

l_003a:
* enable interrupts, now there's a race condition
* because if the dipswitch read code isn't reached before the first irq
* then game sets itself in free play
	 |  [$003c: ei]
	move.b	#0xf7,d0                        	| [$003d: ld   a,$f7]
	LOAD_HL	0x8000                         	| [$0041: ld   hl,$8000]
	LOAD_DE	0x8001                         	| [$0044: ld   de,$8001]
	LOAD_BC	0x0800                         	| [$0047: ld   bc,$0800]
	MAKE_HL	a0                             	| [$004a: ld   (hl),$00]
	clr.b	(a0)                             	| [...]
	jbsr	ldir                              	| [$004c: ldir]
	MAKE_HL_NO_AR                          	| [$004e: push hl]
	move.w	d6,-(a7)                        	| [...]
	move.b	#0x08,d2                        	| [$004f: ld   c,$08]
	MAKE_HL	a0                             	| [$0051: ld   (hl),$60]
	move.b	#0x60,(a0)                      	| [...]
	jbsr	ldir                              	| [$0053: ldir]
	move.b	#0x18,d2                        	| [$0055: ld   c,$18]
	MAKE_HL	a0                             	| [$0057: ld   (hl),$00]
	clr.b	(a0)                             	| [...]
	jbsr	ldir                              	| [$0059: ldir]
	exg	d3,d5                              	| [$005b: ex   de,hl]
	exg	d4,d6                              	| [...]
	move.w	(a7)+,d6                        	| [$005c: pop  hl]
	MAKE_H                                 	| [...]
	LOAD_BC	0x07e0                         	| [$005d: ld   bc,$07e0]
	jbsr	ldir                              	| [$0060: ldir]
	jra	l_04e7                             	| [$0062: jp   $04e7]


