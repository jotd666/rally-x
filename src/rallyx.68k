	jne	l_3e26                             	| [...]
	rts                                    	| [$3e2f: ret]


* < A0: source (HL)
* < A1: destination (DE)
* < D1: length (16 bit)
ldir:
    MAKE_BC_NO_AR
    MAKE_HL_NO_AR
    MAKE_DE_NO_AR
    MAKE_AR_FROM_HL	a0
    MAKE_AR_FROM_DE	a1
    add.w	d2,d6
    add.w	d2,d4
    MAKE_H
    MAKE_D
    subq.w    #1,d2
0:
    move.b    (a0)+,(a1)+
    dbf        d2,0b
    moveq	#0,d2
    moveq	#0,d1
    rts

* < all registers d1/d2/d3/d4/d5/d6
* > all registers swapped
*: note regscopy must be defined somewhere in RAM
*: with a size of 48
exx:
    lea     regscopy+24,a0
    * save current regs in region 1
    movem.l d1/d2/d3/d4/d5/d6,-(a0)
    * restore old regs from region 2
    lea     regscopy+24,a0
    movem.l (a0),d1/d2/d3/d4/d5/d6
    * now copy region 1 to region 2
    movem.l d1/d2/d3/d4/d5/d6,-(a7)
    lea     regscopy,a0
    movem.l (a0)+,d1/d2/d3/d4/d5/d6
    movem.l d1/d2/d3/d4/d5/d6,(a0)
    movem.l (a7)+,d1/d2/d3/d4/d5/d6
    rts
clear_sprites:
	GET_UNCHECKED_ADDRESS	0x8014,a0
	clr.l	(a0)+
	clr.l	(a0)+
	clr.l	(a0)+
	rts


regulate_speed:
    st.b    vbl_sync_flag
    * added to regulate speed, else it's really too fast
    * each nth loop, we sync on vertical blank
    jbsr    osd_get_sync_period
    move.w    vbl_sync_counter,d1
    addq.w    #1,d1
    cmp.w    d1,d0
    bne.b    1f
0:
    tst.b    vbl_sync_flag
    bne.b    0b
    moveq    #0,d1
1:
    move.w    d1,vbl_sync_counter
    rts

decrease_anti_collision_timer:
	GET_ADDRESS	enemy_car_structs_8088,a2  	| [$15d7: ld   ix,enemy_car_structs_8088] [freq=low, count=4%]
	move.b	#0x07,d1                        	| [$15df: ld   b,$07] [freq=low, count=4%]
0:
	move.b	(0x13,a2),d0                    	| [$15e4: ld   a,(ix+$13)] [freq=low, count=21%]
                                         | [$15e7: and  a]
	jeq	next_car_structure                             	| [$15e8: jr   z,$15ef] [freq=low, count=21%]
	subq.b	#1,(0x13,a2)                    	| [$15ea: dec  (ix+$13)] inhibition counter prevents from too many collisions [freq=low, count=2%]

next_car_structure:
	                         	| [$161b: ld   de,$0020] [freq=low, count=16%]
	add.w	#0x20,a2                          	| [$1621: add  ix,de] [freq=low, count=16%]
	subq.b	#1,d1                           	| [$1625: djnz $15e1] [freq=low, count=16%]
	jne	0b                             	| [...]
	rts
	

