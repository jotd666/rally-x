	.include	"options.inc"

	.global infinite_fuel_flag
	.global infinite_lives_flag
	.global invincible_flag
	.global kill_flag
	.global start_level
	.global vb_ticks_count
	.global break_at_startup_flag
	.global log_ptr
	.global	i
	.global	aprime
	.global	fprime
	.global	iyl
	.global	iyh
	.global skip_1c4e

	.global highscore_needs_saving_flag
	.global	regscopy
	.global vbl_sync_counter
	.global vbl_sync_flag
	.global no_sync_flag
	.ifne	OPT_ALIGNED_MEMORY
	.global rom_start_0000
	.endif
	.global rom_buffer
	
	.ifdef   __amiga__
	.ascii	"RAM_STRT"
	.ifndef	RELEASE
	.endif
	.else
	* Neogeo: needs different writable section from ROM code
    .bss
	.endif

	.align	2
	

* rom starts before RAM, at 0
	.ifeq	OPT_ALIGNED_MEMORY
rom_buffer:
	.skip	ROM_SIZE

	.skip	RAM_SIZE
	.else
rom_buffer:
	.skip	0x20000
rom_start_0000:
	.long	0
	.endif


	

high_score_beaten:
	.word	0
stack_top:
	.long	0

	
regscopy:
	.skip	56

fprime:
	.word	0
iyl:
	.word	0		| so it can be saved on stack
aprime:
	.byte	0
iyh:
	.byte	0
i:
	.byte	0
skip_intro_flag:
	.byte	0
skip_1c4e:
	.byte	0
invincible_flag:
	.byte	0
infinite_lives_flag:
	.byte	0
infinite_fuel_flag:
	.byte	0


	.ifndef	RELEASE
log_ptr:
	.long	0x100
	.endif
	
highscore_needs_saving_flag:
	.byte	0
vb_ticks_count:
	.byte	0
current_ticks_count:
	.byte	0
vbl_sync_flag:
	.byte	0
vbl_sync_counter:
	.byte	0



kill_flag:
	.byte 	0
break_at_startup_flag:
	.byte	0

* maybe sound-related?? maybe useless

start_level:
	.byte	0
	.ascii	"RAM_END!"


	